<?xml version="1.0" encoding="utf-8" ?>
<!--
    ViewerRail: the collapsed pane, ViewerRailWidth wide, full height, left of the photo.
     ______
    | [|>] |   expand pane
    |  __  |
    | [o]  |   open photo
    | [<]  |   previous
    | [>]  |   next
    |  __  |
    | [+]  |   zoom in
    | [-]  |   zoom out
    | [fit]|
    | [1:1]|
    |      |
    | [i]  |   details: expands the pane (bottom-aligned)
    |______|

    Same controls as ViewerPane, as icons. Step 2a: expand and details are wired
    (TogglePaneCommand); the rest are stubs for 2b to 2d.
-->
<UserControl
    x:Class="MVVMPhoto.Views.Viewer.ViewerRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Width="{StaticResource ViewerRailWidth}"
        Padding="0,6"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" Spacing="2">
            <Button AutomationProperties.Name="Expand pane" Command="{x:Bind ViewModel.TogglePaneCommand}" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Expand pane (Ctrl+B)">
                <FontIcon Glyph="&#xE8A0;" />
            </Button>
            <Rectangle Style="{StaticResource RailSeparatorStyle}" />
            <Button AutomationProperties.Name="Open photo" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Open photo (Ctrl+O)">
                <FontIcon Glyph="&#xE838;" />
            </Button>
            <Button AutomationProperties.Name="Previous photo" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Previous photo (Left)">
                <FontIcon Glyph="&#xE76B;" />
            </Button>
            <Button AutomationProperties.Name="Next photo" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Next photo (Right)">
                <FontIcon Glyph="&#xE76C;" />
            </Button>
            <Rectangle Style="{StaticResource RailSeparatorStyle}" />
            <Button AutomationProperties.Name="Zoom in" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Zoom in (Ctrl+Plus)">
                <FontIcon Glyph="&#xE8A3;" />
            </Button>
            <Button AutomationProperties.Name="Zoom out" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Zoom out (Ctrl+Minus)">
                <FontIcon Glyph="&#xE71F;" />
            </Button>
            <Button AutomationProperties.Name="Fit to window" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Fit to window (0)">
                <FontIcon Glyph="&#xE9A6;" />
            </Button>
            <Button AutomationProperties.Name="Actual size" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Actual size (1)">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="1:1" />
            </Button>
        </StackPanel>

        <Button
            Grid.Row="1"
            HorizontalAlignment="Center"
            AutomationProperties.Name="Show details"
            Command="{x:Bind ViewModel.TogglePaneCommand}"
            Style="{StaticResource PaneIconButtonStyle}"
            ToolTipService.ToolTip="Details (expands the pane)">
            <FontIcon Glyph="&#xE946;" />
        </Button>
    </Grid>
</UserControl>
