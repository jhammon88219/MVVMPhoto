<?xml version="1.0" encoding="utf-8" ?>
<!--
    ViewerCanvas: the photo area, everything right of the pane. Nothing is ever drawn over the photo.
     ________________________________________
    |                                        |
    |               [photo icon]             |
    |          Open a photo to start         |
    |   Or drop one here. Ctrl+O also works. |
    |              [ Open photo ]            |
    |                                        |
    |________________________________________|

    Step 2a: only the empty state, with a stub button. 2b adds the photo itself and switches
    between the two by view model state.
-->
<UserControl
    x:Class="MVVMPhoto.Views.Viewer.ViewerCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <FontIcon
                Margin="0,0,0,4"
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE91B;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Open a photo to start" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Or drop one here. Ctrl+O also works." />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Content="Open photo"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
