<?xml version="1.0" encoding="utf-8" ?>
<!--
    ShellMenuBar: the app menu, hosted in the title bar (MainWindow's TitleBar.Content).
     ___________________________________
    | File   View   Settings            |
    |___________________________________|

    File       Open...               Ctrl+O
               ______
               Exit

    View       [x] Show pane         Ctrl+B
               ______
               Previous photo        Left
               Next photo            Right
               ______
               Zoom in               Ctrl+Plus
               Zoom out              Ctrl+Minus
               Fit to window         0
               Actual size           1
               ______
               Full screen           F11

    Settings   Theme  >  (o) System  ( ) Light  ( ) Dark
               ______
               Settings...           Ctrl+Comma

    Wired: Open... (real Ctrl+O), Show pane (two-way to Viewer.IsPaneExpanded, real Ctrl+B), Previous /
    Next photo (real Left / Right: these menu items are where the arrow keys are registered, so they work
    with the pane expanded or collapsed). Everything else is a stub: shortcut text shown, not registered.
-->
<UserControl
    x:Class="MVVMPhoto.Views.Shell.ShellMenuBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <MenuBar>
        <MenuBarItem Title="File">
            <MenuFlyoutItem Command="{x:Bind ViewModel.Viewer.OpenCommand}" Text="Open...">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Exit" />
        </MenuBarItem>

        <MenuBarItem Title="View">
            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.Viewer.IsPaneExpanded, Mode=TwoWay}" Text="Show pane">
                <ToggleMenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="B" Modifiers="Control" />
                </ToggleMenuFlyoutItem.KeyboardAccelerators>
            </ToggleMenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Command="{x:Bind ViewModel.Viewer.PreviousCommand}" Text="Previous photo">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE76B;" />
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Command="{x:Bind ViewModel.Viewer.NextCommand}" Text="Next photo">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE76C;" />
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Right" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem KeyboardAcceleratorTextOverride="Ctrl+Plus" Text="Zoom in">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A3;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem KeyboardAcceleratorTextOverride="Ctrl+Minus" Text="Zoom out">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE71F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem KeyboardAcceleratorTextOverride="0" Text="Fit to window">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE9A6;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem KeyboardAcceleratorTextOverride="1" Text="Actual size" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem KeyboardAcceleratorTextOverride="F11" Text="Full screen">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE740;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuBarItem>

        <MenuBarItem Title="Settings">
            <MenuFlyoutSubItem Text="Theme">
                <RadioMenuFlyoutItem GroupName="Theme" IsChecked="True" Text="System" />
                <RadioMenuFlyoutItem GroupName="Theme" Text="Light" />
                <RadioMenuFlyoutItem GroupName="Theme" Text="Dark" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem KeyboardAcceleratorTextOverride="Ctrl+Comma" Text="Settings...">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuBarItem>
    </MenuBar>
</UserControl>
