<?xml version="1.0" encoding="utf-8" ?>
<!--
    MainWindow: the app shell.

     ___________________________________________
    | [icon] MVVMPhoto              title bar   |
    |___________________________________________|
    |                                           |
    |   content: every top-level view is        |
    |   DECLARED here, bound to its child of    |
    |   ShellViewModel; which one shows is      |
    |   shell state (x:Load / Visibility).      |
    |   Nothing navigates in code.              |
    |___________________________________________|

    (Sketches use underscores: an XML comment may not contain two hyphens in a row.)
-->
<Window
    x:Class="MVVMPhoto.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MVVMPhoto"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="MVVMPhoto">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Content area. Empty until step 2 declares the viewer here. -->
        <Grid Grid.Row="1" />
    </Grid>
</Window>
